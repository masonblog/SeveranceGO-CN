{
  "zone_name": "masonhu.cc",
  "worker_name": "severancego-cn",
  "dns_record": {
    "type": "A",
    "name": "severance.masonhu.cc",
    "content": "192.0.2.1",
    "proxied": true,
    "ttl": 1,
    "comment": "Managed by SeveranceGO-CN GitHub Actions; redirect-only hostname"
  },
  "phase": "http_request_dynamic_redirect",
  "rule": {
    "ref": "severancego_legacy_domain_redirect",
    "description": "SeveranceGO-CN legacy domain redirect",
    "expression": "(http.host eq \"severance.masonhu.cc\")",
    "action": "redirect",
    "action_parameters": {
      "from_value": {
        "target_url": {
          "expression": "concat(\"https://severance.masonhu.org\", http.request.uri.path)"
        },
        "status_code": 308,
        "preserve_query_string": true
      }
    },
    "enabled": true
  }
}
